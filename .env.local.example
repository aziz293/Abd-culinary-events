# Copiez ce fichier en .env.local et changez ces valeurs avant de mettre le site en ligne.
ADMIN_PASSWORD=abd-admin-2026
ADMIN_SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Base de données (Supabase) — voir supabase/schema.sql pour créer les tables
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upload de photos (Cloudinary) — voir les instructions fournies pour créer un compte gratuit
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Envoi d'e-mail (Gmail)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Analytics (optionnel) — laissez vide pour désactiver
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Adresse du site une fois en ligne (pour le référencement : sitemap, aperçus de partage...)
NEXT_PUBLIC_SITE_URL=https://abdculinaryevents.sn

# Google Search Console — le code de vérification fourni par Google (voir instructions)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
